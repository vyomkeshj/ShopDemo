{
  "manifestVersion": 1,
  "id": "shop-demo",
  "name": "Shop (demo)",
  "version": "0.5.2",
  "description": "The SDK's reference app \u2014 the smallest thing that touches every access capability once: a catalogue anyone may browse, orders a signed-in customer places and sees only their own, a staff desk, and an owner who sets prices. Orders and addresses live in the app's own tables (plugin.json `db`), scoped by the platform; the catalogue version lives on the timeline.",
  "applicationType": "plugin_shop_demo",
  "entry": "app",
  "icon": "ShoppingBag",
  "roles": {
    "vocabulary": [
      "customer",
      "staff",
      "owner"
    ],
    "default": {
      "owner": "owner",
      "member-edit": "staff",
      "member-readonly": "staff",
      "visitor": "customer",
      "anonymous": "customer",
      "agent": "inherit"
    },
    "describe": {
      "customer": "browses the catalogue, places orders and sees their own",
      "staff": "sees and fulfils every order; never the customer's address book",
      "owner": "everything, including prices"
    }
  },
  "uses": {
    "stock": {
      "contract": "stock/v1",
      "label": "Stock",
      "optional": true
    }
  },
  "channel": {
    "topics": {
      "catalogue": {
        "description": "The catalogue changed \u2014 anyone on the link may hear it."
      },
      "order-status": {
        "audience": "viewer",
        "description": "One customer's own order moved. Only they hear it; staff and the owner may address it, because a refund or a fulfilment is theirs to announce.",
        "mayAddress": [
          "staff",
          "owner"
        ]
      },
      "new-order": {
        "audience": "role:staff",
        "mayAddress": [
          "customer",
          "staff",
          "owner"
        ],
        "description": "A new order reached the desk. Only staff hear it. Everyone who may PLACE an order may ring it \u2014 a shop where staff cannot buy something is a shop with a broken till."
      },
      "cart": {
        "audience": "viewer",
        "mayAddress": [
          "staff",
          "owner"
        ],
        "description": "This person's own basket changed \u2014 so a screen they left open, and the agent that changed it, agree."
      }
    }
  },
  "ops": {
    "browse": {
      "access": "public"
    },
    "product": {
      "access": "public"
    },
    "add-to-cart": {
      "access": "public",
      "requires": "account"
    },
    "set-cart-qty": {
      "access": "public",
      "requires": "account"
    },
    "view-cart": {
      "access": "public",
      "requires": "account"
    },
    "me": {
      "access": "public",
      "requires": "account"
    },
    "checkout": {
      "access": "public",
      "requires": "account"
    },
    "place-order": {
      "access": "public",
      "requires": "account"
    },
    "list-orders": {
      "access": "public",
      "requires": "account"
    },
    "refund": {},
    "set-order-status": {},
    "add-product": {},
    "fulfil-order": {},
    "order-notice": {}
  },
  "routes": {
    "order-updates": {
      "access": "read"
    }
  },
  "kickableTasks": {
    "fulfil": {
      "access": "write"
    },
    "tell-customer": {
      "access": "write"
    }
  },
  "db": {
    "Product": {
      "scope": "instance",
      "fields": {
        "name": "string",
        "priceCents": "int",
        "sku": "string?",
        "active": "boolean=true",
        "description": "text?",
        "tags": "string[]"
      },
      "unique": [
        [
          "sku"
        ]
      ],
      "indexes": [
        [
          "active",
          "createdAt"
        ],
        {
          "fields": [
            "tags"
          ],
          "kind": "contains"
        },
        {
          "fields": [
            "name"
          ],
          "kind": "text"
        }
      ],
      "rules": {
        "read": "anyone",
        "write": [
          "owner"
        ]
      }
    },
    "CartLine": {
      "scope": "instance",
      "owner": "creator",
      "fields": {
        "product": "ref:Product",
        "qty": "int=1"
      },
      "indexes": [
        [
          "product"
        ]
      ],
      "rules": {
        "read": [
          "creator"
        ],
        "create": {
          "roles": [
            "customer",
            "staff",
            "owner"
          ],
          "requires": "account"
        },
        "update": [
          "creator"
        ],
        "delete": [
          "creator"
        ]
      }
    },
    "Order": {
      "scope": "instance",
      "owner": "creator",
      "fields": {
        "status": "string=new",
        "totalCents": "int",
        "lines": "json",
        "shipTo": "json",
        "note": "text?",
        "product": "ref:Product?"
      },
      "indexes": [
        [
          "status"
        ],
        [
          "createdAt"
        ],
        [
          "product"
        ]
      ],
      "rules": {
        "read": [
          "creator",
          "staff",
          "owner"
        ],
        "create": {
          "roles": [
            "customer",
            "staff",
            "owner"
          ],
          "requires": "account"
        },
        "update": {
          "roles": [
            "staff",
            "owner"
          ],
          "creatorMay": [
            "note"
          ]
        },
        "delete": [
          "owner"
        ]
      }
    },
    "Address": {
      "scope": "user",
      "fields": {
        "label": "string",
        "lines": "json"
      },
      "sealed": [
        "lines"
      ]
    }
  }
}
